# Pick ONE provider and set its key. Leave everything unset to run in
# offline/mock mode (deterministic, zero-cost, no signup required) --
# the graph retrieval and ranking logic still runs for real, only the
# natural-language phrasing step is templated instead of LLM-generated.

# LLM_PROVIDER=openai | anthropic | groq | mock  (default: auto-detects from whichever key is set, else "mock")
LLM_PROVIDER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Groq has a free tier and is the fastest way to try this with a real LLM:
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Used by src/api/main.py
API_PORT=8000
